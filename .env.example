# Plantilla para desarrollo local. Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas claves reales al repositorio.
# Si un valor contiene #, espacios o $, escríbelo entre comillas simples: DB_PASSWORD='abc#123'
# Para el servidor usa deploy/panel.env.example (ver deploy/README.md).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agendamiento-citas
DB_USER=
DB_PASSWORD=

# --- Túnel SSH (opcional) ---
# Solo si la base no es accesible directamente desde tu equipo. Vacío = conexión directa.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# --- Modelo de IA (Gemini, API compatible con OpenAI) ---
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# low (rápido, recomendado), medium, high o default
LLM_REASONING_EFFORT=low
# Proxy HTTP de salida, si la red no tiene acceso directo a internet. Ej.: http://proxy.empresa:8080
LLM_PROXY_URL=

# --- Seguridad del panel ---
# Usuario y contraseña para entrar al panel. Vacío = sin contraseña (solo para desarrollo local).
PANEL_USER=
PANEL_PASSWORD=
# Mostrar el SQL generado por el asistente (revela nombres de tablas). En producción por defecto: false.
ASSISTANT_SHOW_SQL=true
# Explorador de tablas (lista toda la estructura de la base). Por defecto: false.
ENABLE_EXPLORER=false
