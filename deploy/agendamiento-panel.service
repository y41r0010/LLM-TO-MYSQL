# Servicio systemd del panel. Instalar en /etc/systemd/system/agendamiento-panel.service
# (ver deploy/README.md). Arranca solo con el servidor y se reinicia si falla.

[Unit]
Description=Panel de agendamiento (Next.js)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/agendamiento-panel/app
# Las claves viven fuera de la carpeta de la app, en un archivo que solo root puede leer.
EnvironmentFile=/etc/agendamiento-panel/panel.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# Memoria limitada: el servidor tiene poca RAM libre.
Environment=NODE_OPTIONS=--max-old-space-size=512
MemoryMax=768M

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/admin/agendamiento-panel/app/.next/cache

[Install]
WantedBy=multi-user.target
