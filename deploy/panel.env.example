# Configuración del panel en el servidor de pruebas (172.20.3.205).
# En el servidor se guarda como /etc/agendamiento-panel/panel.env con permisos 600 (solo root la lee);
# systemd la carga al iniciar el servicio. Ver deploy/README.md.
# Formato systemd: CLAVE=valor, sin "export" ni espacios alrededor del =.
# Si un valor tiene #, $, espacios o comillas, escríbelo entre comillas simples: DB_PASSWORD='abc#12$3'

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Base de datos: MariaDB corre en el mismo servidor, conexión directa (sin túnel SSH) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agendamiento-citas
# Usuario de solo lectura creado con deploy/crear-usuario-lectura.sql (no uses root)
DB_USER=panel_lectura
DB_PASSWORD=

# --- Modelo de IA ---
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_REASONING_EFFORT=low
# El servidor no tiene salida directa a internet: pide a TI un proxy y ponlo aquí (ej. http://proxy.empresa:8080)
LLM_PROXY_URL=

# --- Seguridad ---
# Usuario y contraseña para entrar al panel (obligatorio en el servidor)
PANEL_USER=
PANEL_PASSWORD=
# No mostrar el SQL generado ni la estructura de la base
ASSISTANT_SHOW_SQL=false
ENABLE_EXPLORER=false
